# Copier en .env (ne jamais versionner .env)
OLLAMA_URL=http://localhost:11434
# Fournisseur du LLM : ollama (local) ou openai (API). Les embeddings restent locaux (Ollama) dans les deux cas.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# Pour l'API OpenAI : LLM_PROVIDER=openai, LLM_MODEL=gpt-6-luna, et la clé ci-dessous (dans .env seulement)
OPENAI_API_KEY=
EMBED_MODEL=bge-m3
LLM_TEMPERATURE=0
MAX_AGENT_STEPS=10
MAX_AGENT_TOKENS=20000
AGENT_ROUTER=1
AGENT_FALLBACK=1
AGENT_AUTO_PROPOSITION=1
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
